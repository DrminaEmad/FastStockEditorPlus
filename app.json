{
  "expo": {
    "name": "Scanner Expo Example",
    "slug": "react-native-scanner-expo-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "scanner.expo.example",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcodes"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "scanner.expo.example",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Camera"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3e6c3d0c-9a95-4c35-aeed-dd69560fcc71"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3e6c3d0c-9a95-4c35-aeed-dd69560fcc71"
    }
  }
}
